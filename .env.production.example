# QualityGuard — Production Environment Variables Template
# Copy this file to .env.production on the production host and populate with actual credentials.

# Service configuration
PORT=8787
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://qualityguard.example.com

# PostgreSQL Configuration
DATABASE_URL=postgres://qualityguard:CHANGE_ME_IN_PROD@postgres:5432/qualityguard

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Authentication Secret (32+ bytes random string)
JWT_SECRET=CHANGE_ME_JWT_SECRET_IN_PROD

# GitHub App Integration
# 1. App ID from GitHub App settings page
GITHUB_APP_ID=
# 2. Private Key PEM contents (newline characters encoded as \n or multiline string)
GITHUB_APP_PRIVATE_KEY=
# 3. Webhook Secret configured in GitHub App settings
GITHUB_WEBHOOK_SECRET=

# Stripe Billing Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# External AI Provider (Optional: if omitted, Offline deterministic engine is used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
