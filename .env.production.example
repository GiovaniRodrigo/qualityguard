# ==============================================================================
# QualityGuard Production Environment Configuration (.env.production)
# ==============================================================================
# IMPORTANT:
# 1. Never commit this file with real secrets to version control.
# 2. On the production VPS, store this file at: /opt/qualityguard/.env.production
# 3. Set file permissions: chmod 600 /opt/qualityguard/.env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database name for QualityGuard
POSTGRES_DB=qualityguard

# Database username
POSTGRES_USER=qualityguard

# Strong database password (generate via: openssl rand -hex 32)
POSTGRES_PASSWORD=replace-with-secure-postgres-password-min-32-chars

# Maximum database connection pool size per API instance (default: 10)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT / auth tokens.
# REQUIRED in production. (generate via: openssl rand -base64 48)
QUALITYGUARD_AUTH_SECRET=replace-with-secure-auth-secret-min-48-chars

# ------------------------------------------------------------------------------
# 3. GitHub App Integration (Optional / PR Analysis)
# ------------------------------------------------------------------------------
# GitHub App ID for QualityGuard Bot
GITHUB_APP_ID=

# GitHub App Private Key in PEM format (newlines escaped as \n)
GITHUB_APP_PRIVATE_KEY=

# Webhook secret configured in GitHub App settings for payload verification
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. Stripe Billing & Subscription (Optional / Commercial Platform)
# ------------------------------------------------------------------------------
# Stripe Secret API Key (live mode: sk_live_... or test mode: sk_test_...)
STRIPE_SECRET_KEY=

# Stripe Webhook Endpoint Secret (whsec_...) for verifying incoming webhook signatures
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for tiered subscriptions
STRIPE_PRICE_PRO=price_xxx_pro
STRIPE_PRICE_TEAM=price_xxx_team
STRIPE_PRICE_ENTERPRISE=price_xxx_enterprise

# ------------------------------------------------------------------------------
# 5. AI Governance Providers (Optional / AI Code Review)
# ------------------------------------------------------------------------------
# OpenAI API Key (if using OpenAI provider)
OPENAI_API_KEY=

# Anthropic API Key (if using Claude provider)
ANTHROPIC_API_KEY=

# Google Gemini API Key (if using Gemini provider)
GEMINI_API_KEY=

# Ollama Host URL (if using local/self-hosted Ollama)
OLLAMA_HOST=http://localhost:11434
