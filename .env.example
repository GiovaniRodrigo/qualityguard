# ==============================================================================
# QualityGuard Local Development Environment Configuration (.env)
# ==============================================================================

# Database Configuration (matches local docker-compose.yml)
POSTGRES_DB=qualityguard
POSTGRES_USER=qualityguard
POSTGRES_PASSWORD=qualityguard_local_password
DATABASE_URL=postgresql://qualityguard:qualityguard_local_password@localhost:5432/qualityguard

# Authentication Secret (development only)
QUALITYGUARD_AUTH_SECRET=dev-secret-do-not-use-in-production-min-32-chars

# Port bindings
PORT=8787
WEB_PORT=3000

# Optional GitHub App integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
